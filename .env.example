# Copy thành .env rồi điền giá trị thật. File .env đã được gitignore.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<username>
DB_PASSWORD=<password>
# Chuỗi ngẫu nhiên dài >= 32 ký tự để ký JWT
JWT_SECRET=<chuoi-bi-mat-dai>
# (Tuỳ chọn) tạo sẵn tài khoản admin + dữ liệu gia đình mẫu khi DB còn trống
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<mat-khau-admin>
# (Tuỳ chọn, chỉ dev) mã OTP cố định thay vì ngẫu nhiên
OTP_FIXED_CODE=123456# (Tu? ch?n) �?i c?ng n?u 8080 �? b? chi?m
SERVER_PORT=8080
# Gửi OTP qua Gmail thật: MAIL_USERNAME = địa chỉ Gmail, MAIL_PASSWORD = Mật khẩu ứng dụng 16 ký tự
# (Google Account > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng). Để trống = chỉ in OTP ra log.
MAIL_USERNAME=<ban@gmail.com>
MAIL_PASSWORD=<app-password-16-ky-tu>

# Ghi chi tiêu bằng giọng nói: key Gemini từ Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=<gemini-api-key>
